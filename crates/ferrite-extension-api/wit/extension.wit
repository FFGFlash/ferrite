/// The Ferrite extension API, version 1.
///
/// An extension is a WebAssembly component targeting the `extension` world.
/// It can call only the functions in `host`; there is no filesystem,
/// network, environment, or clock access. See `docs/extensions.md`.
package ferrite:extension@1.0.0;

/// Types shared by the host functions and the extension's exports.
interface types {
  /// Identifies an open document. Never reused while the editor runs.
  type document-id = u64;

  /// A place in a document: a zero-based line, and a column counted in
  /// UTF-8 bytes from the start of that line.
  record position {
    line: u32,
    column: u32,
  }

  /// The text from `start` up to (not including) `end`.
  record range {
    start: position,
    end: position,
  }

  record document-info {
    id: document-id,
    /// Increases with every change to the text.
    version: u64,
    /// The file the document was opened from or saved to.
    path: option<string>,
    /// A language identifier such as `rust`, `typescript`, or `python`.
    language: option<string>,
    line-count: u32,
    /// Length in UTF-8 bytes.
    length: u64,
    /// Whether it has unsaved changes.
    dirty: bool,
  }

  /// Text read from a document, with the version it was read at.
  record text-slice {
    version: u64,
    text: string,
  }

  /// Lines read from a document, with the version they were read at.
  record line-slice {
    version: u64,
    /// The lines, without their line breaks.
    lines: list<string>,
  }

  /// `range`, in the text before this change, was replaced by `text`.
  record text-change {
    range: range,
    text: string,
  }

  record document-change {
    document: document-id,
    /// The version after the changes.
    version: u64,
    /// The changes since the previous notification, in order: each one
    /// applies to the text left by the one before. `none` when they were
    /// too large to send; read the document again.
    changes: option<list<text-change>>,
  }

  /// Replaces `range` with `text`. Line breaks in `text` are converted to
  /// the document's line ending.
  record text-edit {
    range: range,
    text: string,
  }

  enum severity {
    error,
    warning,
    information,
    hint,
  }

  record diagnostic {
    range: range,
    severity: severity,
    message: string,
    /// A short identifier for the kind of problem, e.g. `line-too-long`.
    code: option<string>,
  }

  /// Capabilities an extension can request in its manifest. Only those the
  /// user grants are available.
  enum permission {
    /// Read open documents, receive their changes, publish diagnostics.
    documents-read,
    /// Edit open documents.
    documents-write,
  }

  enum log-level {
    trace,
    debug,
    info,
    warn,
    error,
  }

  enum message-level {
    info,
    warning,
    error,
  }

  /// A configuration value, of the type declared in the manifest.
  variant config-value {
    boolean(bool),
    integer(s64),
    number(f64),
    text(string),
  }

  variant api-error {
    /// The user has not granted the permission this call needs.
    permission-denied(permission),
    /// No open document has this identifier.
    unknown-document,
    /// The document has changed; it is now at the given version.
    stale-version(u64),
    /// A position is outside the document or inside a character.
    invalid-range(string),
    /// The request exceeds one of the host's limits.
    too-large(string),
    invalid-argument(string),
  }

  /// Passed to `activate`.
  record activation {
    /// The permissions the user has granted.
    granted: list<permission>,
  }

  /// Where a command was run from.
  record command-context {
    /// The document in the active editor, if any.
    document: option<document-id>,
    /// That document's selections, the primary one first.
    selections: list<range>,
  }
}

/// Functions the editor provides.
interface host {
  use types.{
    api-error, config-value, diagnostic, document-id, document-info, line-slice, log-level,
    message-level, range, text-edit, text-slice,
  };

  /// Writes to the editor's log, tagged with the extension.
  log: func(level: log-level, message: string);

  /// Shows a notification to the user.
  show-message: func(level: message-level, message: string);

  /// A setting declared in the manifest's `configuration`: the user's
  /// value, or the declared default. `none` for undeclared keys.
  configuration: func(key: string) -> option<config-value>;

  /// The open documents.
  documents: func() -> result<list<document-info>, api-error>;

  document: func(id: document-id) -> result<document-info, api-error>;

  /// Lines `start` up to (not including) `end`, clamped to the document.
  read-lines: func(id: document-id, start: u32, end: u32) -> result<line-slice, api-error>;

  read-range: func(id: document-id, range: range) -> result<text-slice, api-error>;

  /// Applies `edits` as one undoable change if the document is still at
  /// `version`; all or none are applied. Ranges refer to the text at
  /// `version` and must not overlap. Returns the new version.
  apply-edits: func(id: document-id, version: u64, edits: list<text-edit>) -> result<u64, api-error>;

  /// Replaces this extension's diagnostics for a document. Ranges refer to
  /// the text at `version`, which must be the current version or one
  /// recently sent to the extension.
  publish-diagnostics: func(
    id: document-id,
    version: u64,
    diagnostics: list<diagnostic>,
  ) -> result<_, api-error>;
}

world extension {
  use types.{activation, command-context, document-change, document-id, document-info};

  import host;

  /// Called once before any other export. An error fails the extension.
  export activate: func(context: activation) -> result<_, string>;

  /// Called before the extension is unloaded.
  export deactivate: func();

  /// Runs one of the commands declared in the manifest.
  export run-command: func(command: string, context: command-context) -> result<_, string>;

  /// A document was opened, or was already open when the extension was
  /// activated. Only sent with the `documents-read` permission, as are the
  /// other document notifications.
  export document-opened: func(document: document-info);

  export document-changed: func(change: document-change);

  export document-closed: func(document: document-id);
}
